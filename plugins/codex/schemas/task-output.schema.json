{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "outcomeStatus",
    "report",
    "changedFiles",
    "checks",
    "blocker",
    "inspected",
    "evidence"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "outcomeStatus": {
      "type": "string",
      "enum": [
        "READY_FOR_INTEGRATION",
        "COMPLETED_READ_ONLY",
        "BLOCKED",
        "NEEDS_CONTEXT",
        "PARTIAL",
        "FAILED"
      ]
    },
    "report": { "type": "string", "minLength": 1 },
    "changedFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "status", "summary"],
        "properties": {
          "command": { "type": "string" },
          "status": { "type": "string", "enum": ["PASS", "FAIL", "EXPECTED_FAIL", "SKIPPED"] },
          "summary": { "type": "string" }
        }
      }
    },
    "blocker": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "message", "retryWhen"],
          "properties": {
            "kind": { "type": "string", "minLength": 1 },
            "message": { "type": "string", "minLength": 1 },
            "retryWhen": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "inspected": { "type": "boolean" },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
